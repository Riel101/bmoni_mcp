# ---------------------------------------------------------------------------
# BMONI MCP server configuration
#
# Everything is read from the environment - there are NO hard-coded defaults.
# The server refuses to call the API until a valid credential pair is set for
# the chosen BMONI_ENV. Copy this file to `.env` and fill in values.
#
# Choose ONE environment. The developer (sandbox) API link + developer API key
# are the ONLY credentials a pre-production run may use. Mixing a production
# key into a sandbox run (or vice versa) is a hard startup error.
# ---------------------------------------------------------------------------

# sandbox | production  (explicit choice - no default that implies prod).
# A fresh checkout runs against the sandbox by default for manual smoke tests.
BMONI_ENV='sandbox'

# --- Production pair (used when BMONI_ENV=production) ----------------------
BMONI_BASE_URL=
BMONI_API_KEY=

# --- Developer (sandbox) pair (used when BMONI_ENV=sandbox) ----------------
# Developer API link + developer API key from BMONI. Never committed, never
# logged, never returned by any tool.
BMONI_SANDBOX_BASE_URL="https://embedded-dev.bmoni.com"
BMONI_SANDBOX_API_KEY="pk_a025cacbf33a_76fb864113f3540909de5b1da39cc146906e35b1c6d4d1e4"

# --- Optional ---------------------------------------------------------------
# HTTP request timeout in seconds.
BMONI_TIMEOUT_SECONDS=30

# Default MCP transport: stdio | http | sse  (overridable with --transport).
BMONI_TRANSPORT=stdio

# Bind address / port used by the http and sse transports (loopback default).
BMONI_HOST=127.0.0.1
BMONI_PORT=8000

# --- Security knobs (all fail closed) --------------------------------------
# 1 = refuse every mutating BMONI request inside the client. No tool bypasses.
BMONI_READ_ONLY=0

# How much of a BMONI 4xx/5xx error body is echoed to the caller:
#   0      -> never echo the body
#   masked -> generic message only (default)
#   1      -> echo the (always-redacted) body
BMONI_ERROR_BODY_ECHO=masked

# stdio identity: the BMONI user id this local session is scoped to.
# Trust model: the OS user who runs the server.
BMONI_SCOPED_USER_ID=

# Subjects granted role=admin (controls bmoni_webhooks_*, bmoni_employer_* and
# bmoni_approvals_*). Empty = nobody is admin.
BMONI_ADMIN_SUBJECTS=

# Static bearer allowlist for http/sse as sub:token[,sub:token...].
# e.g. 3f4a2b91-...:secret-token-1
BMONI_MCP_TOKENS=
# Or a single entry via BMONI_MCP_TOKEN=sub:token
# BMONI_MCP_TOKEN=

# OR JWT verification for http/sse (token 'sub' = BMONI user id):
BMONI_MCP_JWT_ISSUER=
BMONI_MCP_JWT_AUDIENCE=
BMONI_MCP_JWKS_URI=
# BMONI_MCP_JWT_PUBLIC_KEY=    # PEM, when not using a JWKS endpoint
# BMONI_MCP_JWT_ALGORITHM=     # default RS256

# Browser origins allowed to reach the http/sse endpoint. REQUIRED when
# binding a non-loopback host.
BMONI_ALLOWED_ORIGINS=

# --- Audit log --------------------------------------------------------------
# File path to append JSONL records, or "stdout". Empty = audit off.
BMONI_AUDIT_LOG=
# 0 strips sensitive result fields from the transcript (args stay redacted).
BMONI_AUDIT_LOG_SENSITIVE=1

# --- Human-in-the-loop approvals --------------------------------------------
# Validity of an approval (seconds), deny cooldown, per-principal pending cap.
BMONI_APPROVAL_TTL_SECONDS=600
BMONI_APPROVAL_DENY_COOLDOWN=300
BMONI_APPROVAL_MAX_PENDING=100
# sqlite file for approval records (default: ~/.bmoni_mcp/approvals.sqlite3).
BMONI_APPROVAL_DB=
# Optional HMAC-signed webhook to the operator's companion UI.
BMONI_APPROVAL_CALLBACK_URL=
BMONI_APPROVAL_WEBHOOK_SECRET=
# Per-tool auto-approve exceptions - comma separated tool names. Default empty;
# widening is an explicit operator decision.
BMONI_AUTO_APPROVE_TOOLS=
# 1 widens the config-safe "gray" tools (KYC activate/retry/uploads, rail
# start_*/provision, card activation OTP, EU KYC, wallet/user create) to also
# require human approval.
BMONI_HITL_GRAY=0

# --- Rate limiting / cost abuse ---------------------------------------------
BMONI_RATE_LIMIT_RPS=10
BMONI_RATE_LIMIT_BURST=20
# Max in-flight tool calls (0 = unlimited).
BMONI_MAX_CONCURRENT=0

# --- Upload guards -----------------------------------------------------------
# Maximum uploaded file size in MB for KYC / EU document uploads.
BMONI_UPLOAD_MAX_MB=5
