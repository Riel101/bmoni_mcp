# ---------------------------------------------------------------------------
# BMONI MCP server configuration
#
# Both required values come from your BMONI partner onboarding. There are NO
# hard-coded defaults: the server refuses to call the API until these are set.
# Copy this file to `.env` (or export the variables) before running.
# ---------------------------------------------------------------------------

# Base URL of the BMONI Embedded API host your partner account is on.
# Example: https://embedded.api.bmoni.example
BMONI_BASE_URL=

# Partner API key. Sent with every request as the `x-api-key` header.
BMONI_API_KEY=

# --- Optional ---------------------------------------------------------------
# HTTP request timeout in seconds.
BMONI_TIMEOUT_SECONDS=30

# Default MCP transport: stdio | http | sse  (overridable with --transport).
BMONI_TRANSPORT=stdio

# Bind address / port used by the http and sse transports.
BMONI_HOST=127.0.0.1
BMONI_PORT=8000
